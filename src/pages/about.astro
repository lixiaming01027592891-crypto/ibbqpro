---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="關於愛烤PRO｜苗栗到府烤肉服務團隊" description="愛烤PRO 成立於苗栗卓蘭，由一群熱愛烤肉文化的職人組成，提供到府代烤、活動烤肉服務，為每一場聚會帶來美味與歡樂。">
  <Nav />

  <!-- Hero -->
  <section class="pt-24 pb-16 px-4" style="background-color: #FAF6F1;">
    <div class="max-w-6xl mx-auto text-center">
      <h1 class="text-3xl font-medium mb-4" style="color: #2C1810;">關於愛烤PRO</h1>
      <p class="text-base max-w-2xl mx-auto" style="color: #8C7B6B; line-height: 1.75;">從一份熱情開始，為每一場聚會帶來美味與歡樂</p>
    </div>
  </section>

  <!-- Brand Story -->
  <section class="py-20 px-4" style="background-color: #FAF6F1;">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-2xl font-medium text-center mb-10" style="color: #2C1810;">品牌故事</h2>
      <div class="space-y-6 text-base" style="color: #3D2B1F; line-height: 1.75;">
        <p>
          愛烤PRO 成立於苗栗卓蘭，由一群熱愛烤肉文化的職人組成。我們從小小的烤肉攤開始，一路走來始終堅持對食材品質的嚴格把關與對服務細節的極致追求。
        </p>
        <p>
          我們相信，烤肉不只是一頓飯，更是人與人之間連結的橋樑。在炭火的溫暖光芒下，家人、朋友、同事圍坐在一起，分享美食與歡笑，這些時光才是最珍貴的回憶。
        </p>
        <p>
          從家庭聚餐到企業活動，我們用心準備每一場烤肉體驗。無論是在自家庭院、露營區還是民宿包棟，愛烤PRO 的專業團隊都會到府服務，讓您輕鬆享受烤肉的樂趣，無需煩惱準備與收拾的繁瑣。
        </p>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-20 px-4" style="background-color: #FAF6F1;">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-2xl font-medium text-center mb-4" style="color: #2C1810;">核心價值</h2>
      <p class="text-base text-center mb-12" style="color: #8C7B6B;">我們堅持的四個承諾</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Value 1 -->
        <div class="text-center p-6 rounded-lg" style="background-color: #FFFFFF;">
          <div class="w-12 h-12 mx-auto mb-4 flex items-center justify-center rounded-full" style="background-color: #C75B39;">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-medium mb-2" style="color: #2C1810;">專業職人</h3>
          <p class="text-sm" style="color: #8C7B6B; line-height: 1.75;">經驗豐富的烤肉團隊，掌握火候與風味</p>
        </div>

        <!-- Value 2 -->
        <div class="text-center p-6 rounded-lg" style="background-color: #FFFFFF;">
          <div class="w-12 h-12 mx-auto mb-4 flex items-center justify-center rounded-full" style="background-color: #C75B39;">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-medium mb-2" style="color: #2C1810;">新鮮食材</h3>
          <p class="text-sm" style="color: #8C7B6B; line-height: 1.75;">嚴選當日新鮮食材，品質把關</p>
        </div>

        <!-- Value 3 -->
        <div class="text-center p-6 rounded-lg" style="background-color: #FFFFFF;">
          <div class="w-12 h-12 mx-auto mb-4 flex items-center justify-center rounded-full" style="background-color: #C75B39;">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-medium mb-2" style="color: #2C1810;">貼心服務</h3>
          <p class="text-sm" style="color: #8C7B6B; line-height: 1.75;">從準備到收尾，讓您無後顧之憂</p>
        </div>

        <!-- Value 4 -->
        <div class="text-center p-6 rounded-lg" style="background-color: #FFFFFF;">
          <div class="w-12 h-12 mx-auto mb-4 flex items-center justify-center rounded-full" style="background-color: #C75B39;">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </div>
          <h3 class="text-lg font-medium mb-2" style="color: #2C1810;">彈性客製</h3>
          <p class="text-sm" style="color: #8C7B6B; line-height: 1.75;">依人數、預算、場地需求量身規劃</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 px-4" style="background-color: #FAF6F1;">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-medium mb-6" style="color: #2C1810;">準備好開始您的烤肉體驗了嗎？</h2>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact" class="inline-block px-8 py-3 rounded text-white transition-opacity duration-200 hover:opacity-90" style="background-color: #C75B39;">
          聯絡我們
        </a>
        <a href="/booking" class="inline-block px-8 py-3 rounded border transition-colors duration-200 hover:opacity-90" style="border-color: #C75B39; color: #C75B39;">
          立即預約
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
