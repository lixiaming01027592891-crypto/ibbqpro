---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageBanner from "../components/PageBanner.astro";

const serviceCards = [
  {
    image: "/images/service-family.jpg",
    title: "家庭聚餐",
    description: "生日、家族聚會、節慶聚餐。親子友善、食材新鮮。",
  },
  {
    image: "/images/service-company.jpg",
    title: "公司派對",
    description: "尾牙、慶功、團建、員工聚餐。專業團隊到場服務。",
  },
  {
    image: "/images/service-camping.jpg",
    title: "露營／民宿",
    description: "露營區、民宿包棟、戶外聚會。彈性菜單，戶外友善。",
  },
  {
    image: "/images/service-outdoor.jpg",
    title: "戶外活動",
    description: "開幕活動、戶外派對、節慶烤肉。Buffet 餐車服務。",
  },
];

const basicMenu = {
  title: "超值套餐",
  price: "$20,000 起",
  note: "20人份",
  categories: [
    { name: "前菜", items: "必吃開胃鳳爪、黃金泡菜" },
    { name: "蔬菜小物", items: "新鮮櫛瓜、帶殼玉米筍、醬燒杏鮑菇、新鮮香菇、擺盤配菜、炭烤新鮮吐司" },
    { name: "海鮮", items: "直火炭烤大魷魚、挪威鯖魚、糖果白蝦" },
    { name: "肉品", items: "美國 Choice 帶骨牛小排、美國 1855 翼板牛排、醬燒黑豬肉片、碳燒鹹豬肉、老店手工香腸、椒鹽去骨雞腿排" },
    { name: "串燒烤物", items: "愛烤PRO綜合串、爆汁雞肉捲、真・天婦羅、椒鹽糯米腸" },
  ],
};

const premiumMenu = {
  title: "老饕套餐",
  price: "$25,000 起",
  note: "20人份",
  categories: [
    { name: "前菜", items: "必吃開胃鳳爪、黃金泡菜" },
    { name: "蔬菜小物", items: "新鮮櫛瓜、帶殼玉米筍、醬燒杏鮑菇、新鮮香菇、擺盤配菜、碳烤奶酥餐包" },
    { name: "海鮮", items: "北海道生食級干貝、直火炭烤大魷魚、糖果白蝦" },
    { name: "肉品", items: "美國安格斯無骨牛小排、美國肋眼沙朗原塊、法式小羔羊排、國產頂級松阪豬、醬燒黑豬肉片、老店手工香腸、椒鹽去骨雞腿排、櫻桃鴨胸" },
    { name: "串燒烤物", items: "愛烤PRO綜合串、爆汁雞肉捲、真・天婦羅、椒鹽糯米腸" },
  ],
};

const addons = [
  { name: "美國無骨牛小排", spec: "600g", price: "$990" },
  { name: "美國帶骨牛小排", spec: "600g", price: "$590" },
  { name: "台灣松阪豬", spec: "600g", price: "$490" },
  { name: "伊比利豬肋條", spec: "500g", price: "$690" },
  { name: "活泰國蝦", spec: "600g", price: "$600" },
  { name: "黃金桶仔雞", spec: "全隻", price: "$600" },
  { name: "炒飯 / 炒麵 / 炒米粉", spec: "一人份", price: "$75" },
  { name: "海尼根生啤機（含設備）", spec: "8公升", price: "$1,790" },
];
---

<BaseLayout title="服務方案與菜單｜愛烤PRO">
  <Nav />

  <!-- 1. PageBanner -->
  <PageBanner
    title="服務方案與菜單"
    breadcrumb={[
      { label: "首頁", href: "/" },
      { label: "服務方案" },
    ]}
  />

  <!-- 2. 服務類型 -->
  <section class="spad" style="background-color: #FAF6F1; padding: 64px 0;">
    <div class="container">
      <h2 style="font-size: 28px; font-weight: 500; color: #2C1810; text-align: center; margin-bottom: 32px;">
        服務類型
      </h2>
      <div class="t4grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;">
        {
          serviceCards.map((card) => (
            <div class="scard" style="background-color: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 1px 6px #2c18100f;">
              <img
                src={card.image}
                alt={card.title}
                style="width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block;"
                loading="lazy"
              />
              <h3 style="font-size: 16px; font-weight: 500; color: #2c1810; padding: 16px 16px 4px;">
                {card.title}
              </h3>
              <p style="font-size: 13px; color: #8c7b6b; padding: 0 16px 16px; line-height: 1.6;">
                {card.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. 精選菜單 -->
  <section id="menu" class="spad" style="background-color: #fff; padding: 64px 0;">
    <div class="container">
      <h2 style="font-size: 28px; font-weight: 500; color: #2C1810; text-align: center; margin-bottom: 8px;">
        精選菜單
      </h2>
      <p style="font-size: 14px; color: #8c7b6b; text-align: center; margin-bottom: 32px;">
        依季節與食材新鮮度調整，品項可客製化
      </p>
      <div class="m2grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;">
        <!-- 超值套餐 -->
        <div style="border: 1px solid rgba(44,24,16,0.1); border-radius: 10px; overflow: hidden;">
          <div style="background-color: #2c1810; color: #faf6f1; padding: 20px 24px;">
            <h3 style="font-size: 18px; font-weight: 500;">{basicMenu.title}</h3>
            <div style="font-size: 20px; color: #c75b39; font-weight: 500; margin-top: 4px;">
              {basicMenu.price}
            </div>
            <div style="font-size: 13px; color: #8c7b6b; margin-top: 2px;">
              {basicMenu.note}
            </div>
          </div>
          <div style="padding: 20px 24px;">
            {
              basicMenu.categories.map((cat) => (
                <div style="margin-bottom: 12px;">
                  <h4 style="font-size: 14px; font-weight: 500; color: #c75b39; margin-bottom: 4px;">
                    {cat.name}
                  </h4>
                  <p style="font-size: 14px; color: #3d2b1f; line-height: 1.6;">
                    {cat.items}
                  </p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- 老饕套餐 -->
        <div style="border: 1px solid #c75b39; border-radius: 10px; overflow: hidden; position: relative;">
          <span
            style="position: absolute; top: 0; right: 24px; background-color: #c75b39; color: #fff; font-size: 12px; padding: 4px 12px; border-radius: 0 0 4px 4px; z-index: 1;"
          >
            推薦
          </span>
          <div style="background-color: #2c1810; color: #faf6f1; padding: 20px 24px;">
            <h3 style="font-size: 18px; font-weight: 500;">{premiumMenu.title}</h3>
            <div style="font-size: 20px; color: #c75b39; font-weight: 500; margin-top: 4px;">
              {premiumMenu.price}
            </div>
            <div style="font-size: 13px; color: #8c7b6b; margin-top: 2px;">
              {premiumMenu.note}
            </div>
          </div>
          <div style="padding: 20px 24px;">
            {
              premiumMenu.categories.map((cat) => (
                <div style="margin-bottom: 12px;">
                  <h4 style="font-size: 14px; font-weight: 500; color: #c75b39; margin-bottom: 4px;">
                    {cat.name}
                  </h4>
                  <p style="font-size: 14px; color: #3d2b1f; line-height: 1.6;">
                    {cat.items}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. 加購品項 -->
  <section class="spad" style="background-color: #FAF6F1; padding: 64px 0;">
    <div class="container">
      <h2 style="font-size: 28px; font-weight: 500; color: #2C1810; text-align: center; margin-bottom: 32px;">
        加購品項
      </h2>
      <table class="addon-tb" style="width: 100%; border-collapse: collapse; font-size: 14px;">
        <thead>
          <tr>
            <th style="text-align: left; padding: 10px 16px; background-color: #2c1810; color: #faf6f1; font-weight: 500;">品項</th>
            <th style="text-align: left; padding: 10px 16px; background-color: #2c1810; color: #faf6f1; font-weight: 500;">規格</th>
            <th style="text-align: left; padding: 10px 16px; background-color: #2c1810; color: #faf6f1; font-weight: 500;">價格</th>
          </tr>
        </thead>
        <tbody>
          {
            addons.map((item) => (
              <tr>
                <td style="padding: 10px 16px; border-bottom: 1px solid #e5e5e5; color: #3d2b1f;">{item.name}</td>
                <td style="padding: 10px 16px; border-bottom: 1px solid #e5e5e5; color: #8c7b6b;">{item.spec}</td>
                <td style="padding: 10px 16px; border-bottom: 1px solid #e5e5e5; color: #3d2b1f; font-weight: 500;">{item.price}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p style="font-size: 13px; color: #8c7b6b; text-align: center; margin-top: 16px;">
        如沒有喜好品項可詢問，菜單依季節調整，實際內容以預約確認為準。
      </p>
    </div>
  </section>

  <!-- 5. CTA -->
  <section style="background-color: #2C1810; padding: 56px 0; text-align: center;">
    <div class="container">
      <h2 style="font-size: 28px; font-weight: 500; color: #fff; margin-bottom: 24px;">
        想預約服務？
      </h2>
      <div style="display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
        <a
          href="/booking"
          style="display: inline-block; padding: 12px 32px; background-color: #c75b39; color: #fff; text-decoration: none; border-radius: 6px; font-size: 16px; font-weight: 500;"
        >
          線上預約
        </a>
        <a
          href="tel:0909204600"
          style="display: inline-block; padding: 12px 32px; background-color: transparent; color: #fff; text-decoration: none; border-radius: 6px; font-size: 16px; font-weight: 500; border: 1px solid rgba(255,255,255,0.4);"
        >
          撥打電話
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media (max-width: 768px) {
    .t4grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 12px !important;
    }
    .m2grid {
      grid-template-columns: 1fr !important;
    }
    .spad {
      padding: 40px 0 !important;
    }
  }
</style>
