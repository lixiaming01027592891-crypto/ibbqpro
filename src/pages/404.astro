---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="找不到頁面｜愛烤PRO"
  description="您要找的頁面不存在，讓我們帶您返回愛烤PRO首頁，探索到府烤肉服務。"
  noindex={true}
>
  <main class="min-h-[70vh] flex items-center justify-center px-4">
    <div class="text-center max-w-lg mx-auto">
      <!-- 404 數字 -->
      <h1 class="text-8xl font-bold text-bbq-orange mb-4 tracking-tight">
        404
      </h1>

      <!-- 錯誤訊息 -->
      <p class="text-2xl font-semibold text-bbq-text mb-2">頁面找不到</p>
      <p class="text-bbq-brown/70 mb-8 leading-relaxed">
        您要找的頁面似乎已經被烤熟了，或是從來不曾存在過。
      </p>

      <!-- 返回首頁按鈕 -->
      <a
        href="/"
        class="inline-flex items-center gap-2 px-8 py-3.5 bg-bbq-orange hover:bg-bbq-orange-dark text-white font-semibold rounded-full transition-all duration-300 hover:scale-105 hover:shadow-lg"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
          ></path>
        </svg>
        返回首頁
      </a>
    </div>
  </main>
</BaseLayout>
