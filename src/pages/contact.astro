---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const contactInfo = [
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`,
    label: "電話",
    value: "0909-204-600",
    href: "tel:0909204600",
    subtext: "點擊直撥",
  },
  {
    icon: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>`,
    label: "LINE",
    value: "@905pkprt",
    href: null,
    subtext: null,
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    label: "Email",
    value: "a0909204600@gmail.com",
    href: "mailto:a0909204600@gmail.com",
    subtext: null,
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    label: "地址",
    value: "苗栗縣卓蘭鎮大仁街26號",
    href: null,
    subtext: null,
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    label: "營業時間",
    value: "每日 10:00-22:00",
    href: null,
    subtext: null,
  },
];
---

<BaseLayout title="聯絡愛烤PRO｜苗栗到府烤肉、代烤服務" description="有任何問題，歡迎隨時與愛烤PRO聯繫。電話 0909-204-600、LINE @905pkprt，提供苗栗到府烤肉與代烤服務。">
  <Nav />

  <!-- Hero -->
  <section class="pt-24 pb-12 px-4" style="background-color: #FAF6F1;">
    <div class="max-w-6xl mx-auto text-center">
      <h1 class="text-3xl font-medium mb-4" style="color: #2C1810;">聯絡愛烤PRO</h1>
      <p class="text-base max-w-2xl mx-auto" style="color: #8C7B6B; line-height: 1.75;">有任何問題，歡迎隨時與我們聯繫</p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="pb-20 px-4" style="background-color: #FAF6F1;">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Left: Contact Info -->
      <div class="p-8 rounded-lg" style="background-color: #FFFFFF;">
        <h2 class="text-xl font-medium mb-6" style="color: #2C1810;">聯絡資訊</h2>
        <div class="space-y-4">
          {contactInfo.map((item) => (
            <div class="flex items-start gap-4 p-4 rounded-lg transition-colors duration-200 hover:bg-[#C75B39]/5">
              <div class="flex-shrink-0" style="color: #C75B39;">
                <Fragment set:html={item.icon} />
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm" style="color: #8C7B6B;">{item.label}</p>
                {item.href ? (
                  <a href={item.href} class="text-base font-medium transition-opacity duration-200 hover:opacity-80" style="color: #3D2B1F;">{item.value}</a>
                ) : (
                  <p class="text-base font-medium" style="color: #3D2B1F;">{item.value}</p>
                )}
                {item.subtext && <p class="text-xs mt-1" style="color: #8B6914;">{item.subtext}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Quick Form -->
      <div class="p-8 rounded-lg" style="background-color: #FFFFFF;">
        <h2 class="text-xl font-medium mb-6" style="color: #2C1810;">快速聯絡</h2>
        <form action="https://formspree.io/f/xnqevjzy" method="POST" class="space-y-5">
          <div>
            <label for="contact-name" class="block text-sm font-medium mb-2" style="color: #3D2B1F;">姓名</label>
            <input type="text" id="contact-name" name="name" required class="w-full px-4 py-3 rounded border text-base focus:outline-none focus:ring-2 transition-shadow" style="border-color: #E8E0D8; color: #3D2B1F; --tw-ring-color: #C75B39;" placeholder="請輸入姓名" />
          </div>
          <div>
            <label for="contact-phone" class="block text-sm font-medium mb-2" style="color: #3D2B1F;">電話</label>
            <input type="tel" id="contact-phone" name="phone" required class="w-full px-4 py-3 rounded border text-base focus:outline-none focus:ring-2 transition-shadow" style="border-color: #E8E0D8; color: #3D2B1F; --tw-ring-color: #C75B39;" placeholder="請輸入聯絡電話" />
          </div>
          <div>
            <label for="contact-message" class="block text-sm font-medium mb-2" style="color: #3D2B1F;">訊息內容</label>
            <textarea id="contact-message" name="message" rows="4" required class="w-full px-4 py-3 rounded border text-base focus:outline-none focus:ring-2 transition-shadow resize-none" style="border-color: #E8E0D8; color: #3D2B1F; --tw-ring-color: #C75B39;" placeholder="請輸入您的問題或需求"></textarea>
          </div>
          <button type="submit" class="w-full px-8 py-3 rounded text-white text-base font-medium transition-opacity duration-200 hover:opacity-90" style="background-color: #C75B39;">
            送出訊息
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-20 px-4" style="background-color: #FAF6F1;">
    <div class="max-w-6xl mx-auto text-center p-8 rounded-lg" style="background-color: #FFFFFF;">
      <h2 class="text-xl font-medium mb-3" style="color: #2C1810;">想要直接預約服務？</h2>
      <p class="text-sm mb-6" style="color: #8C7B6B;">填寫完整的預約表單，讓我們為您量身規劃烤肉體驗</p>
      <a href="/booking" class="inline-block px-8 py-3 rounded text-white transition-opacity duration-200 hover:opacity-90" style="background-color: #C75B39;">
        前往線上預約
      </a>
    </div>
  </section>

  <Footer />
</BaseLayout>
