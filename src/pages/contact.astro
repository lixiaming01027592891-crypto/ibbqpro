        <a href="https://www.instagram.com/ibbqpro/" class="socard" target="_blank" rel="noopener noreferrer">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <rect x="2" y="2" width="20" height="20" rx="6" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/>
          </svg>
          <span>Instagram</span>
        </a>
        <a href="https://www.tiktok.com/@pro559509" class="socard" target="_blank" rel="noopener noreferrer">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M9 3v12.55A4.5 4.5 0 1 1 7.5 12V8h3a5 5 0 0 0 5-5V3h-1.5v2a3.5 3.5 0 0 1-3.5 3.5h-1.5V3z" fill="currentColor"/>
          </svg>
          <span>TikTok</span>
        </a>
        <a href="https://www.youtube.com/channel/UCL08VRymkYi0b5c4JqAEeyA" class="socard" target="_blank" rel="noopener noreferrer">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21.8 8.04c-.2-.74-.78-1.32-1.52-1.52C18.51 6 12 6 12 6s-6.51 0-8.28.52c-.74.2-1.32.78-1.52 1.52C2 9.8 2 12 2 12s0 2.2.2 3.96c.2.74.78 1.32 1.52 1.52C5.49 18 12 18 12 18s6.51 0 8.28-.52c.74-.2 1.32-.78 1.52-1.52C22 14.2 22 12 22 12s0-2.2-.2-3.96zM10 15V9l5.2 3L10 15z" fill="currentColor"/>
