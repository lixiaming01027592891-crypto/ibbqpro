          <p style="font-size: 14px; color: #3d2b1f; margin: 0 0 6px;">@905pkprt</p>
          <em style="font-size: 13px; color: #c75b39; font-weight: 500; font-style: normal;">加入好友</em>
        </a>
        <a href="mailto:a0909204600@gmail.com" class="ccard">
          <div style="font-size: 32px;">✉️</div>
          <h3 style="font-size: 16px; font-weight: 500; color: #2c1810; margin: 12px 0 6px;">Email</h3>
          <p style="font-size: 14px; color: #3d2b1f; margin: 0 0 6px;">a0909204600@gmail.com</p>
          <em style="font-size: 13px; color: #c75b39; font-weight: 500; font-style: normal;">發送郵件</em>
        </a>
        <span class="ccard" style="cursor: default;">
          <div style="font-size: 32px;">📍</div>
          <h3 style="font-size: 16px; font-weight: 500; color: #2c1810; margin: 12px 0 6px;">地址</h3>
          <p style="font-size: 14px; color: #3d2b1f; margin: 0 0 6px;">苗栗縣卓蘭鎮大仁街26號</p>
