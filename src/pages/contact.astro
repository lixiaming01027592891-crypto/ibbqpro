  </section>

  <!-- Section 3: 追蹤我們 -->
  <section style="background: #fff; padding: 64px 0;">
    <div class="container">
      <h2 style="text-align: center; color: #2c1810; margin: 0 0 8px;">追蹤我們</h2>
      <p style="text-align: center; color: #8C7B6B; margin: 0 0 32px;">關注愛烤PRO最新動態與活動花絮</p>
      <div class="s4grid" style="max-width: 600px; margin: 0 auto;">
        <a href="https://www.facebook.com/profile.php?id=61560094407223" class="socard" target="_blank" rel="noopener noreferrer">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <text x="12" y="16" text-anchor="middle" font-size="11" font-weight="600" fill="currentColor">f</text>
