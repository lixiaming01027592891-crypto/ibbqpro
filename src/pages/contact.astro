  <!-- Section 4: CTA -->
  <section style="background: #2C1810; padding: 56px 0; text-align: center;">
    <div class="container">
      <h2 style="color: #fff; margin: 0 0 24px;">準備預約了嗎？</h2>
      <a href="/booking" class="btn-primary">線上預約</a>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .c4grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .ccard {
    display: block;
    background: #fff;
    border-radius: 10px;
    padding: 28px;
    text-align: center;
    box-shadow: 0 1px 6px #2c18100f;
    transition: box-shadow .2s, transform .2s;
    text-decoration: none;
    color: inherit;
  }

  .ccard:hover {
    box-shadow: 0 4px 16px #2c18101a;
    transform: translateY(-2px);
  }

  .s4grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .socard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 24px;
    border: 1px solid rgba(44,24,16,0.1);
    border-radius: 10px;
    color: #3d2b1f;
    text-decoration: none;
    transition: all .2s;
  }

  .socard:hover {
    border-color: #c75b39;
    color: #c75b39;
  }

  .btn-primary {
    display: inline-block;
    background: #C75B39;
    color: #fff;
    padding: 14px 40px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: background .2s;
  }

  .btn-primary:hover {
    background: #a84a2d;
  }

  @media (max-width: 768px) {
    .c4grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .s4grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .ccpad {
      padding: 40px 0 !important;
    }
  }
</style>
