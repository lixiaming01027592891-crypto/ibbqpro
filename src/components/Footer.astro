    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- 品牌 -->
      <div>
        <p class="text-white font-medium text-lg mb-3">愛烤PRO</p>
        <p class="text-white/60 text-sm leading-relaxed">
          苗栗卓蘭到府烤肉・專人代烤服務。家庭聚餐、公司派對、露營民宿，輕鬆開烤。
        </p>
      </div>

      <!-- 聯絡資訊 -->
      <div>
        <p class="text-white font-medium text-sm mb-3">聯絡資訊</p>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="tel:0909204600" class="text-white/60 hover:text-white transition-colors">
              0909-204-600
            </a>
          </li>
          <li class="text-white/60">@905pkprt（LINE）</li>
          <li>
            <a href="mailto:a0909204600@gmail.com" class="text-white/60 hover:text-white transition-colors break-all">
              a0909204600@gmail.com
            </a>
          </li>
          <li class="text-white/60">苗栗縣卓蘭鎮大仁街26號</li>
          <li class="text-white/60">每日 10:00–22:00</li>
