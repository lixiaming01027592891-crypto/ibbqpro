const socials = [
  { label: "Facebook", href: "https://www.facebook.com/profile.php?id=61560094407223" },
  { label: "Instagram", href: "https://www.instagram.com/ibbqpro/" },
  { label: "TikTok", href: "https://www.tiktok.com/@pro559509" },
  { label: "YouTube", href: "https://www.youtube.com/channel/UCL08VRymkYi0b5c4JqAEeyA" },
