---
---

<section id="cases" class="py-20 px-4 bg-white">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-2xl font-medium text-[#2C1810] text-center mb-4">精選案例</h2>
    <p class="text-[#8C7B6B] text-center mb-12">實際服務場景，讓您更了解我們</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- 案例 1: 藍鵲度假莊園 -->
      <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-[#FAF6F1]">
        <img
          src="/images/case1.png"
          alt="苗栗通霄藍鵲度假莊園到府烤肉服務"
          class="w-full h-56 object-cover rounded-t-lg"
        />
        <div class="p-5">
          <h3 class="text-base font-medium text-[#2C1810]">藍鵲度假莊園</h3>
          <p class="text-sm text-[#8C7B6B] mt-1">苗栗縣通霄鎮</p>
          <p class="text-sm text-[#C75B39] mt-1">民宿代烤</p>
          <p class="text-sm text-[#3D2B1F]/80 mt-2 leading-relaxed">
            多次前往藍鵲度假莊園提供到府代烤服務，依民宿場地與人數安排烤具、食材與現場協助。
          </p>
        </div>
      </div>

      <!-- 案例 2: 風山雅筑 -->
      <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-[#FAF6F1]">
        <img
          src="/images/case2.png"
          alt="苗栗銅鑼風山雅筑包棟民宿烤肉服務"
          class="w-full h-56 object-cover rounded-t-lg"
        />
        <div class="p-5">
          <h3 class="text-base font-medium text-[#2C1810]">風山雅筑</h3>
          <p class="text-sm text-[#8C7B6B] mt-1">苗栗縣銅鑼鄉</p>
          <p class="text-sm text-[#C75B39] mt-1">包棟民宿</p>
          <p class="text-sm text-[#3D2B1F]/80 mt-2 leading-relaxed">
            於銅鑼風山雅筑包棟民宿提供代烤服務，風景優美、空氣清新，適合親友聚會烤肉。
          </p>
        </div>
      </div>

      <!-- 案例 3: 陽明山美國村 -->
      <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-[#FAF6F1]">
        <img
          src="/images/case3.png"
          alt="台北陽明山美國村到府烤肉活動"
          class="w-full h-56 object-cover rounded-t-lg"
        />
        <div class="p-5">
          <h3 class="text-base font-medium text-[#2C1810]">陽明山美國村</h3>
          <p class="text-sm text-[#8C7B6B] mt-1">台北市士林區</p>
          <p class="text-sm text-[#C75B39] mt-1">包棟活動</p>
          <p class="text-sm text-[#3D2B1F]/80 mt-2 leading-relaxed">
            於陽明山美國村包棟民宿舉辦烤肉活動，依場地特性規劃菜單與烤具配置，現場專人協助。
          </p>
        </div>
      </div>

      <!-- 案例 4: 歐風民宿 -->
      <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-[#FAF6F1]">
        <img
          src="/images/case4.png"
          alt="苗栗公館歐風民宿到府代烤服務"
          class="w-full h-56 object-cover rounded-t-lg"
        />
        <div class="p-5">
          <h3 class="text-base font-medium text-[#2C1810]">公館歐風民宿</h3>
          <p class="text-sm text-[#8C7B6B] mt-1">苗栗縣公館鄉 · 約20人</p>
          <p class="text-sm text-[#C75B39] mt-1">民宿聚餐</p>
          <p class="text-sm text-[#3D2B1F]/80 mt-2 leading-relaxed">
            於公館歐風民宿提供到府代烤服務，約20人規模，依人數與場地安排專屬菜單與現場協助。
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
