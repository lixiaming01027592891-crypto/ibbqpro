---
---

<section id="cases" class="py-20 px-4 bg-white">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-2xl font-medium text-[#2C1810] text-center mb-4">精選案例</h2>
    <p class="text-[#8C7B6B] text-center mb-12">實際服務場景，讓您更了解我們</p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- 案例 1 -->
      <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-[#FAF6F1]">
        <img
          src="/images/case1.png"
          alt="苗栗卓蘭家庭聚餐烤肉案例"
          class="w-full h-56 object-cover rounded-t-lg"
        />
        <div class="p-5">
          <h3 class="text-base font-medium text-[#2C1810]">卓蘭家庭聚餐</h3>
          <p class="text-sm text-[#8C7B6B] mt-1">苗栗縣卓蘭鎮 · 20人</p>
          <p class="text-sm text-[#C75B39] mt-1">生日聚會</p>
          <p class="text-sm text-[#3D2B1F]/80 mt-2 leading-relaxed">
            為家庭成員慶祝生日，於自宅庭院舉辦烤肉聚餐。依人數與偏好安排菜單，現場協助開烤與食材準備。
          </p>
        </div>
      </div>

      <!-- 案例 2 -->
      <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-[#FAF6F1]">
        <img
          src="/images/case2.png"
          alt="苗栗民宿包棟烤肉服務案例"
          class="w-full h-56 object-cover rounded-t-lg"
        />
        <div class="p-5">
          <h3 class="text-base font-medium text-[#2C1810]">苗栗民宿包棟</h3>
          <p class="text-sm text-[#8C7B6B] mt-1">苗栗縣大湖鄉 · 25人</p>
          <p class="text-sm text-[#C75B39] mt-1">朋友聚餐</p>
          <p class="text-sm text-[#3D2B1F]/80 mt-2 leading-relaxed">
            民宿包棟兩天一夜，第二天傍晚安排烤肉活動。依民宿場地條件調整烤具與食材，提供現場協助。
          </p>
        </div>
      </div>

      <!-- 案例 3 -->
      <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-[#FAF6F1]">
        <img
          src="/images/case3.png"
          alt="台中公司聚餐到府烤肉案例"
          class="w-full h-56 object-cover rounded-t-lg"
        />
        <div class="p-5">
          <h3 class="text-base font-medium text-[#2C1810]">台中公司聚餐</h3>
          <p class="text-sm text-[#8C7B6B] mt-1">台中市北屯區 · 40人</p>
          <p class="text-sm text-[#C75B39] mt-1">員工活動</p>
          <p class="text-sm text-[#3D2B1F]/80 mt-2 leading-relaxed">
            科技公司季度員工聚餐，於公司頂樓空間舉辦。依預算與人數規劃菜單，活動前到場準備器具與食材。
          </p>
        </div>
      </div>

      <!-- 案例 4 -->
      <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-[#FAF6F1]">
        <img
          src="/images/case4.png"
          alt="露營區戶外烤肉活動案例"
          class="w-full h-56 object-cover rounded-t-lg"
        />
        <div class="p-5">
          <h3 class="text-base font-medium text-[#2C1810]">露營區烤肉</h3>
          <p class="text-sm text-[#8C7B6B] mt-1">苗栗縣泰安鄉 · 30人</p>
          <p class="text-sm text-[#C75B39] mt-1">戶外聚會</p>
          <p class="text-sm text-[#3D2B1F]/80 mt-2 leading-relaxed">
            露營區草地廣場舉辦團體烤肉，依戶外場地條件準備烤具與食材，活動期間提供現場協助。
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
