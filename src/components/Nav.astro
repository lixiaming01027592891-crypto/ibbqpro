---
const currentPath = Astro.url.pathname;
---

<nav id="main-nav" class="fixed top-0 w-full z-50 bg-white transition-shadow duration-200">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex-shrink-0">
      <span class="font-medium text-xl" style="color: #C75B39;">愛烤</span><span class="font-medium text-xl" style="color: #2C1810;">PRO</span>
    </a>

    <!-- Desktop Links -->
    <div class="hidden md:flex items-center gap-8">
      <a href="/#services" class="text-sm font-medium transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">服務方案</a>
      <a href="/#cases" class="text-sm font-medium transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">精選案例</a>
      <a href="/blog" class="text-sm font-medium transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">部落格</a>
      <a href="/#faq" class="text-sm font-medium transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">常見問題</a>
      <a href="/contact" class="text-sm font-medium transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">聯絡我們</a>
    </div>

    <!-- Desktop Right -->
    <div class="hidden md:flex items-center gap-4">
      <a href="tel:0909204600" class="text-sm font-medium transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">0909204600</a>
      <a href="/booking" class="text-sm font-medium px-4 py-2 rounded text-white transition-colors duration-200 hover:opacity-90" style="background-color: #C75B39;">立即預約</a>
    </div>

    <!-- Hamburger Button -->
    <button id="menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="開啟選單">
      <span class="block w-5 h-0.5 transition-transform duration-200" style="background-color: #2C1810;"></span>
      <span class="block w-5 h-0.5 transition-opacity duration-200" style="background-color: #2C1810;"></span>
      <span class="block w-5 h-0.5 transition-transform duration-200" style="background-color: #2C1810;"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden bg-white border-t" style="border-color: #F0EBE5;">
    <div class="px-4 py-4 flex flex-col gap-4">
      <a href="/" class="text-base font-medium py-2 transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">首頁</a>
      <a href="/#services" class="text-base font-medium py-2 transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">服務方案</a>
      <a href="/#cases" class="text-base font-medium py-2 transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">精選案例</a>
      <a href="/blog" class="text-base font-medium py-2 transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">部落格</a>
      <a href="/#faq" class="text-base font-medium py-2 transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">常見問題</a>
      <a href="/about" class="text-base font-medium py-2 transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">關於我們</a>
      <a href="/contact" class="text-base font-medium py-2 transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">聯絡我們</a>
      <a href="tel:0909204600" class="text-base font-medium py-2 transition-colors duration-200 hover:text-[#C75B39]" style="color: #3D2B1F;">0909204600</a>
      <a href="/booking" class="text-base font-medium text-center py-3 rounded text-white transition-colors duration-200 hover:opacity-90" style="background-color: #C75B39;">立即預約</a>
    </div>
  </div>
</nav>

<!-- Mobile Floating CTA -->
<div class="md:hidden fixed bottom-0 left-0 w-full z-40 bg-white border-t px-4 py-3" style="border-color: #F0EBE5;">
  <a href="/booking" class="block text-center text-base font-medium py-3 rounded text-white transition-colors duration-200 hover:opacity-90" style="background-color: #C75B39;">立即預約</a>
</div>

<script>
  (function() {
    const nav = document.getElementById('main-nav');
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuLinks = mobileMenu.querySelectorAll('a');
    const bars = menuBtn.querySelectorAll('span');
    let isOpen = false;

    // Scroll shadow
    function handleScroll() {
      if (window.scrollY > 10) {
        nav.classList.add('shadow-sm');
      } else {
        nav.classList.remove('shadow-sm');
      }
    }
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Hamburger toggle
    menuBtn.addEventListener('click', function() {
      isOpen = !isOpen;
      if (isOpen) {
        mobileMenu.classList.remove('hidden');
        bars[0].style.transform = 'translateY(6px) rotate(45deg)';
        bars[1].style.opacity = '0';
        bars[2].style.transform = 'translateY(-6px) rotate(-45deg)';
      } else {
        mobileMenu.classList.add('hidden');
        bars[0].style.transform = '';
        bars[1].style.opacity = '';
        bars[2].style.transform = '';
      }
    });

    // Close menu on link click
    menuLinks.forEach(function(link) {
      link.addEventListener('click', function() {
        isOpen = false;
        mobileMenu.classList.add('hidden');
        bars[0].style.transform = '';
        bars[1].style.opacity = '';
        bars[2].style.transform = '';
      });
    });
  })();
</script>
