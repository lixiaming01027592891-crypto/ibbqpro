---
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: "關於我們", href: "/about" },
  { label: "服務方案", href: "/services" },
  { label: "精選案例", href: "/gallery" },
  { label: "愛烤日記", href: "/blog" },
  { label: "線上預約", href: "/booking" },
  { label: "常見問題", href: "/faq" },
  { label: "聯絡我們", href: "/contact" },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<!-- 導航列 -->
<nav
  id="main-nav"
  style="position: fixed; top: 0; width: 100%; z-index: 100; transition: background 0.3s ease, box-shadow 0.3s ease, backdrop-filter 0.3s ease;"
>
  <div
    class="max-w-6xl mx-auto px-4 md:px-6 flex items-center justify-between"
    style="height: 72px;"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 flex-shrink-0" aria-label="愛烤PRO 首頁">
      <!-- 火焰 SVG -->
      <svg width="40" height="40" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="flex-shrink-0">
        <circle cx="32" cy="32" r="30" fill="#C75B39" opacity="0.12"/>
        <path d="M32 14C32 14 20 24 20 36C20 42 24 48 32 50C40 48 44 42 44 36C44 24 32 14 32 14Z" fill="#C75B39"/>
        <path d="M32 20C32 20 25 28 25 35C25 39 28 43 32 45C36 43 39 39 39 35C39 28 32 20 32 20Z" fill="#E8784A"/>
        <path d="M32 26C32 26 28 32 28 37C28 39 30 41 32 42C34 41 36 39 36 37C36 32 32 26 32 26Z" fill="#F5A070"/>
      </svg>
      <!-- 品牌文字 -->
      <span class="text-xl font-bold tracking-tight" style="color: #2C3E33;">愛烤<span style="color: #C75B39;">PRO</span></span>
    </a>

    <!-- 桌面導航連結 (>= 768px) -->
    <div class="hidden md:flex items-center" style="gap: 28px;">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium transition-colors duration-200"
            style={isActive(link.href)
              ? "color: #C75B39;"
              : "color: #3D3D3D;"
            }
            onmouseenter="this.style.color='#C75B39'"
            onmouseleave={isActive(link.href) ? "this.style.color='#C75B39'" : "this.style.color='#3D3D3D'"}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- 漢堡選單按鈕 (行動端) -->
    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="開啟選單"
      aria-expanded="false"
    >
      <span
        id="bar-1"
        class="block w-5 h-0.5 transition-all duration-300"
        style="background-color: #3D3D3D;"></span>
      <span
        id="bar-2"
        class="block w-5 h-0.5 transition-all duration-300"
        style="background-color: #3D3D3D;"></span>
      <span
        id="bar-3"
        class="block w-5 h-0.5 transition-all duration-300"
        style="background-color: #3D3D3D;"></span>
    </button>
  </div>
</nav>

<!-- 行動端全螢幕選單 -->
<div
  id="mobile-menu"
  class="md:hidden fixed inset-0 flex flex-col items-center justify-center gap-6"
  style="background: rgba(0,0,0,0.88); z-index: 99; opacity: 0; visibility: hidden; transition: opacity 0.3s ease, visibility 0.3s ease;"
>
  <!-- 關閉按鈕 -->
  <button
    id="menu-close"
    class="absolute top-5 right-5 p-2 text-white"
    aria-label="關閉選單"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 6L6 18M6 6l12 12"/>
    </svg>
  </button>

  {
    navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-link text-white font-medium transition-opacity duration-200 hover:opacity-80"
        style="font-size: 20px;"
      >
        {link.label}
      </a>
    ))
  }
</div>

<!-- 行動端底部浮動條 -->
<div
  class="md:hidden fixed left-0 w-full"
  style="bottom: 0; z-index: 98; background: #C75B39;"
>
  <a
    href="/booking"
    class="block text-center text-white text-base font-medium"
    style="padding: 14px 28px;"
  >
    立即預約
  </a>
</div>

<script>
  (function() {
    const nav = document.getElementById('main-nav');
    const menuBtn = document.getElementById('menu-btn');
    const menuClose = document.getElementById('menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuLinks = mobileMenu.querySelectorAll('.mobile-nav-link');
    const bar1 = document.getElementById('bar-1');
    const bar2 = document.getElementById('bar-2');
    const bar3 = document.getElementById('bar-3');

    // 滾動效果：初始透明 → 滾動後毛玻璃
    function handleScroll() {
      if (window.scrollY > 10) {
        nav.style.background = 'rgba(250, 246, 241, 0.95)';
        nav.style.backdropFilter = 'blur(10px)';
        nav.style.WebkitBackdropFilter = 'blur(10px)';
        nav.style.boxShadow = '0 1px 4px rgba(0,0,0,0.08)';
      } else {
        nav.style.background = 'transparent';
        nav.style.backdropFilter = 'none';
        nav.style.WebkitBackdropFilter = 'none';
        nav.style.boxShadow = 'none';
      }
    }
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // 開啟選單
    function openMenu() {
      mobileMenu.style.opacity = '1';
      mobileMenu.style.visibility = 'visible';
      menuBtn.setAttribute('aria-expanded', 'true');
      // 漢堡變 X
      bar1.style.transform = 'translateY(6px) rotate(45deg)';
      bar1.style.backgroundColor = '#fff';
      bar2.style.opacity = '0';
      bar3.style.transform = 'translateY(-6px) rotate(-45deg)';
      bar3.style.backgroundColor = '#fff';
      // 禁止背景滾動
      document.body.style.overflow = 'hidden';
    }

    // 關閉選單
    function closeMenu() {
      mobileMenu.style.opacity = '0';
      mobileMenu.style.visibility = 'hidden';
      menuBtn.setAttribute('aria-expanded', 'false');
      // X 變漢堡
      bar1.style.transform = '';
      bar1.style.backgroundColor = '#3D3D3D';
      bar2.style.opacity = '1';
      bar3.style.transform = '';
      bar3.style.backgroundColor = '#3D3D3D';
      // 恢復滾動
      document.body.style.overflow = '';
    }

    menuBtn.addEventListener('click', function() {
      if (menuBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menuClose.addEventListener('click', closeMenu);

    menuLinks.forEach(function(link) {
      link.addEventListener('click', closeMenu);
    });
  })();
</script>
