---
---

<section id="services" class="py-20 px-4 bg-[#FAF6F1]">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-2xl font-medium text-[#2C1810] text-center mb-4">服務方案</h2>
    <p class="text-[#8C7B6B] text-center mb-12">依您的需求，提供最適合的烤肉體驗</p>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- 卡片 1: 家庭聚餐 -->
      <div class="bg-white rounded-lg shadow-sm flex flex-col overflow-hidden">
        <img
          src="/images/family.png"
          alt="家庭聚餐烤肉服務"
          class="w-full h-48 object-cover rounded-t-lg"
        />
        <div class="p-6 flex flex-col flex-1">
          <h3 class="text-lg font-medium text-[#2C1810]">家庭聚餐</h3>
          <p class="text-sm text-[#8C7B6B] mt-1">生日、家族聚會、節慶聚餐</p>

          <ul class="mt-4 space-y-2">
            <li class="flex items-start gap-2 text-sm text-[#3D2B1F]">
              <svg class="w-4 h-4 text-[#C75B39] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              親子友善
            </li>
            <li class="flex items-start gap-2 text-sm text-[#3D2B1F]">
              <svg class="w-4 h-4 text-[#C75B39] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              食材新鮮
            </li>
            <li class="flex items-start gap-2 text-sm text-[#3D2B1F]">
              <svg class="w-4 h-4 text-[#C75B39] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              現場協助
            </li>
          </ul>

          <p class="text-[#C75B39] font-medium mt-4">依人數洽詢</p>

          <a href="/contact" class="mt-auto inline-block text-center border border-[#C75B39] text-[#C75B39] px-4 py-2 rounded text-sm hover:bg-[#C75B39]/5 transition-colors">
            了解詳情
          </a>
        </div>
      </div>

      <!-- 卡片 2: 公司派對 -->
      <div class="bg-white rounded-lg shadow-sm flex flex-col overflow-hidden">
        <img
          src="/images/company.png"
          alt="公司派對到府烤肉"
          class="w-full h-48 object-cover rounded-t-lg"
        />
        <div class="p-6 flex flex-col flex-1">
          <h3 class="text-lg font-medium text-[#2C1810]">公司派對</h3>
          <p class="text-sm text-[#8C7B6B] mt-1">尾牙、慶功、團建、員工聚餐</p>

          <ul class="mt-4 space-y-2">
            <li class="flex items-start gap-2 text-sm text-[#3D2B1F]">
              <svg class="w-4 h-4 text-[#C75B39] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              到場準備
            </li>
            <li class="flex items-start gap-2 text-sm text-[#3D2B1F]">
              <svg class="w-4 h-4 text-[#C75B39] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              聚餐省心
            </li>
            <li class="flex items-start gap-2 text-sm text-[#3D2B1F]">
              <svg class="w-4 h-4 text-[#C75B39] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              流程清楚
            </li>
          </ul>

          <p class="text-[#C75B39] font-medium mt-4">依人數洽詢</p>

          <a href="/contact" class="mt-auto inline-block text-center border border-[#C75B39] text-[#C75B39] px-4 py-2 rounded text-sm hover:bg-[#C75B39]/5 transition-colors">
            了解詳情
          </a>
        </div>
      </div>

      <!-- 卡片 3: 露營／民宿包棟 -->
      <div class="bg-white rounded-lg shadow-sm flex flex-col overflow-hidden">
        <img
          src="/images/camping.png"
          alt="露營民宿烤肉服務"
          class="w-full h-48 object-cover rounded-t-lg"
        />
        <div class="p-6 flex flex-col flex-1">
          <h3 class="text-lg font-medium text-[#2C1810]">露營／民宿包棟</h3>
          <p class="text-sm text-[#8C7B6B] mt-1">露營區、民宿包棟、戶外聚會</p>

          <ul class="mt-4 space-y-2">
            <li class="flex items-start gap-2 text-sm text-[#3D2B1F]">
              <svg class="w-4 h-4 text-[#C75B39] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              戶外友善
            </li>
            <li class="flex items-start gap-2 text-sm text-[#3D2B1F]">
              <svg class="w-4 h-4 text-[#C75B39] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              彈性菜單
            </li>
            <li class="flex items-start gap-2 text-sm text-[#3D2B1F]">
              <svg class="w-4 h-4 text-[#C75B39] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              現場協助
            </li>
          </ul>

          <p class="text-[#C75B39] font-medium mt-4">依人數洽詢</p>

          <a href="/contact" class="mt-auto inline-block text-center border border-[#C75B39] text-[#C75B39] px-4 py-2 rounded text-sm hover:bg-[#C75B39]/5 transition-colors">
            了解詳情
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
