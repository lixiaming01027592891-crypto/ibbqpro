---
---

<section class="pt-24 lg:pt-32 pb-16 lg:pb-24" style="background-color: #FAF6F1;">
  <div class="max-w-6xl mx-auto px-4 flex flex-col lg:flex-row items-center gap-10 lg:gap-16">
    <!-- Left: Text -->
    <div class="w-full lg:w-1/2 opacity-0 animate-fade-in">
      <!-- Badge -->
      <span class="inline-block px-3 py-1 rounded-full text-sm font-medium" style="background-color: rgba(199,91,57,0.1); color: #C75B39;">
        苗栗・卓蘭 到府服務
      </span>

      <!-- H1 -->
      <h1 class="text-3xl lg:text-[32px] font-medium leading-tight mt-5" style="color: #2C1810;">
        專業到府烤肉<br>
        把歡樂帶到您的場地<br>
        愛烤PRO為您服務
      </h1>

      <!-- Subtitle -->
      <p class="text-base lg:text-lg mt-4" style="color: #8C7B6B;">
        家庭聚餐・公司派對・露營民宿｜專人到府・食材新鮮・輕鬆開烤
      </p>

      <!-- CTA Buttons -->
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#cta" class="inline-block px-6 py-3 rounded text-white font-medium transition-colors duration-200 hover:opacity-90" style="background-color: #C75B39;">
          預約烤肉
        </a>
        <a href="#services" class="inline-block px-6 py-3 rounded font-medium border transition-colors duration-200 hover:bg-[rgba(199,91,57,0.05)]" style="border-color: #C75B39; color: #C75B39;">
          看服務方案
        </a>
      </div>
    </div>

    <!-- Right: Image -->
    <div class="w-full lg:w-1/2 opacity-0 animate-fade-in" style="animation-delay: 150ms;">
      <img
        src="/images/hero.png"
        alt="愛烤PRO 到府烤肉現場"
        class="w-full h-auto rounded-lg shadow-lg object-cover"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .animate-fade-in {
    animation: fadeIn 600ms ease-out forwards;
  }
</style>
